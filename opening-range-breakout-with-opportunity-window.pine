// This is a modified version of the [LuxAlgo - ORB & Targets](https://www.tradingview.com/script/fCqLTp6r-Opening-Range-with-Breakouts-Targets-LuxAlgo/) indicator from LuxAlgo
//
// This work is licensed under a Attribution-NonCommercial-ShareAlike 4.0 International (CC BY-NC-SA 4.0) https://creativecommons.org/licenses/by-nc-sa/4.0/
// © n8rzz - Nate Geslin

// @version=6
indicator("Opening Range with Breakouts, Targets & Opportunity Window", shorttitle = "ORB Op Win", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// --- Inputs ---
// Historical Display
showHistoricalData = input.bool(false, title = "Show Historical Data", group = "Historical Display", tooltip = "Displays All Data from Previous Sessions")

// Timezone
timezoneInputGroup = "Timezone"
tz = input.string("UTC-5", title = "Timezone", group = timezoneInputGroup, tooltip = "Sets the timezone used by all time-based settings in this indicator, including Opening Range, Opportunity Window, and recurring VWAP anchor timing.", options = ["UTC-10", "UTC-8", "UTC-7", "UTC-6", "UTC-5", "UTC-4", "UTC-3", "UTC+0", "UTC+1", "UTC+2", "UTC+3", "UTC+3:30", "UTC+4", "UTC+5", "UTC+5:30", "UTC+5:45", "UTC+6", "UTC+6:30", "UTC+7", "UTC+8", "UTC+9", "UTC+9:30", "UTC+10", "UTC+11", "UTC+12", "UTC+12:45", "UTC+13"])

// Opening Range
orSizeTargetInputGroup = "Opening Range Size Target"
orTimePeriod = input.timeframe("60", title = "Length", group = "Opening Range", tooltip = "Sets the Length of Time used for determining Opening Range")
customRangeSession = input.session("0830-0930", title = "Opening Range Timeframe", group = orSizeTargetInputGroup)
showSecondRange = input.bool(true, title = "Show Secondary OR Session", group = orSizeTargetInputGroup)
secondRangeSession = input.session("0100-0200", title = "Secondary OR Timeframe", group = orSizeTargetInputGroup)
secondRangeColor = input.color(color.new(color.blue, 84), title = "Secondary OR Fill Color", group = orSizeTargetInputGroup)

// Opening Range Size (% of current price)
orSizePct = input.float(0.2, minval = 0.0, step = 0.01, title = "Opening Range Size (%)", group = orSizeTargetInputGroup, tooltip = "Defines the target opening-range size as a percent of current price. The indicator compares actual OR width to this target to compute the range ratio, drive range-quality color/readiness, and update the OR size label metrics.")
sizeGoodColor = input.color(color.new(#00ff00, 90), title = "Good Range Size", group = orSizeTargetInputGroup, tooltip = "Color when opening range size meets or exceeds target")
sizeBadColor = input.color(color.new(#ff0000, 90), title = "Poor Range Size", group = orSizeTargetInputGroup, tooltip = "Color when opening range size is below target")
sizeNeutralColor = input.color(color.new(color.yellow, 85), title = "Neutral", group = orSizeTargetInputGroup, tooltip = "OR Session has not completed yet")
shouldShowOrbSizeLabel = input.bool(true, title = "Show ORB Range Size Label", group = orSizeTargetInputGroup, tooltip = "Displays the Opening Range height (Δ value) above the OR box")

// Targets
targetPercentOfRange = input.float(50, minval = 1, title = "Target % of Range", group = "Targets", tooltip = "Uses this % of OR Width to use as the distance for targets.") * 0.01
targetCrossSource = input.string("Close", title = "Target Cross Source", options = ["Close", "Highs/Lows"], group = "Targets", tooltip = "Uses this Source to tell the script when a target is hit in order to draw the next target.")
targetDisplay = input.string("Adaptive", title = "Target Display", options = ["Adaptive", "Extended"], group = "Targets", tooltip = "Adaptive: Displays and hides targets Adaptivly based on the current price.\nExtended: Extends all targets to the current bar and does not hide any targets after generation.")
targetLineStyle = input.string(". . .", title = "Target Line Style", options = [". . .", "- - -", "___"], group = "Targets")
targetPlotLineStyle = targetLineStyle == "___" ? plot.linestyle_solid : targetLineStyle == "- - -" ? plot.linestyle_dashed : plot.linestyle_dotted
targetLabelSize = str.lower(input.string("Normal", title = "Target Label Size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = "Targets"))
shouldShowTargets = input.bool(true, title = "Show Targets", group = "Targets")

// Opportunity Window
opportunityWindowInputGroup = "Opportunity Window"
opportunityWindowSession = input.session("0930-1200", title = "Start + End", group = opportunityWindowInputGroup, inline = "OWTime")
secondaryOpportunityWindowSession = input.session("0200-0600", title = "Secondary Start + End", group = opportunityWindowInputGroup, inline = "OWTime2")
owColor = input.color(color.new(#7b1fa2, 85), title = "Opportunity Window Fill Color", group = opportunityWindowInputGroup)
shouldShowOpportunityWindowMidline = input.bool(true, "Show Midline", group = opportunityWindowInputGroup)
shouldShowOpportunityWindow = input.bool(true, title = "Show Opportunity Window", group = opportunityWindowInputGroup)

// Breakout Signals
shouldShowBreakoutSignals = input.bool(true, title = "Show Breakout Signals", group = "Breakout Signals")
useDailySignalBias = input.string("No Bias", title = "Signal Bias", options = ["No Bias", "Daily Bias"], group = "Breakout Signals", tooltip = "OR Fill Color is directional based on if the current Day/Session ORM is Above or Below the Previous ORM.\nExamples\nNo Bias: Signals Occur Regardless of OR Color\nDaily Bias: Signals do not fire until Target 1 when Breakout is in opposite direction of OR Color.") == "Daily Bias"
signalSize = str.lower(input.string("Large", title = "Signal Size", options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = "Breakout Signals"))
upSignalColor = input.color(color.new(#00ff00, 10), title = "Up Color", group = "Breakout Signals")
downSignalColor = input.color(color.new(#ff0000, 10), title = "Down Color", group = "Breakout Signals")
shouldClampSignalsToOpportunityWindow = input.bool(true, title = "Clamp signals to Opportunity Window", group = "Breakout Signals")

// VWAP
shouldShowVWAP = input.bool(true, title = "Show VWAP", group = "VWAP")
vwapAnchorMode = input.string("Recurring Time", title = "Anchor Mode", options = ["Recurring Time", "Session Open"], group = "VWAP", tooltip = "Selects how VWAP resets. Recurring Time: resets once per day at the configured Recurring Anchor Time using the indicator Timezone. Session Open: resets at each regular market session open (session.ismarket).")
vwapAnchorSession = input.session("1700-1701", title = "Recurring Anchor Time", group = "VWAP")
vwapStdDevMultiplier = input.float(2.0, minval = 0.1, step = 0.1, title = "Standard Deviation Multiplier", group = "VWAP", tooltip = "Multiplier for VWAP standard deviation bands")
vwapStdDevMultiplier2 = input.float(3.0, minval = 0.1, step = 0.1, title = "Second Standard Deviation Multiplier", group = "VWAP")
vwapColor = input.color(color.new(color.yellow, 0), title = "VWAP Color", group = "VWAP")
vwapUpperBandColor = input.color(color.new(color.white, 90), title = "Upper Band Color", group = "VWAP")
vwapLowerBandColor = input.color(color.new(color.white, 90), title = "Lower Band Color", group = "VWAP")
vwapUpperBandColor2 = input.color(color.new(color.white, 70), title = "Second Upper Band Color", group = "VWAP")
vwapLowerBandColor2 = input.color(color.new(color.white, 70), title = "Second Lower Band Color", group = "VWAP")

// Moving Average
maInputGroup = "Moving Average"
shouldShowMA = input.bool(true, title = "Show Moving Average", group = maInputGroup)
maSource = input.source(close, title = "Source", group = maInputGroup, tooltip = "Price series the moving average is computed on (e.g. Close, HL2, HLC3, OHLC4). VWMA still weights by volume.")
maType = input.string("EMA", title = "Average Type", options = ["SMA", "EMA", "RMA", "WMA", "VWMA"], group = maInputGroup, tooltip = "RMA is Wilder smoothing. SMMA is smoothed MA (used in tools like Williams Alligator). ALMA uses offset 0.85 and sigma 6. LinReg is linear regression of the selected source.")
maLength = input.int(20, title = "Length", minval = 1, group = maInputGroup)
maColor = input.color(color.new(#00BCD4, 0), title = "Color", group = maInputGroup)

// Alerts
isAlertAboveEnabled = input.bool(true, title = "Enable Alert: Cross Above ORH", group = "Alerts")
isAlertBelowEnabled = input.bool(true, title = "Enable Alert: Cross Below ORL", group = "Alerts")

invisibleColor = color.rgb(0, 0, 0, 100)
orLineColor = color.new(color.purple, 50)
orSizeLabelPaddingBottom = syminfo.mintick * 5
secOwExtLineColor = color.new(color.blue, 0)

// --- Error ---
if timeframe.in_seconds(timeframe.period) >= timeframe.in_seconds("D")
    runtime.error("Timeframe is too High! Please Reduce Timeframe to be Less-Than 1 Day.")

// --- UDTs ---
type TargetDisplay
    label displayLabel

// --- Functions ---
// Map selected MA type to ta.* (ALMA uses fixed offset/sigma; LinReg on `source` at `offset=0`).
// SMMA is handled separately with `var` state because it needs a recursive seed.
movingAverage(series float source, simple int length, simple string averageType) =>
    averageType == "SMA" ? ta.sma(source, length) :
     averageType == "EMA" ? ta.ema(source, length) :
     averageType == "RMA" ? ta.rma(source, length) :
     averageType == "WMA" ? ta.wma(source, length) :
     averageType == "VWMA" ? ta.vwma(source, length) :
     averageType == "HMA" ? ta.hma(source, length) :
     averageType == "ALMA" ? ta.alma(source, length, 0.85, 6) :
     averageType == "LinReg" ? ta.linreg(source, length, 0) :
     ta.sma(source, length)

// Smallest integer >= value (ceil) without ta.ceil, used for target index math.
ceilToInt(float value) =>
    (value - math.floor(value)) > 0 ? int(math.floor(value) + 1) : int(value)

// Bars from the current bar until a session string's end time (HHMM-HHMM).
barsUntilSessionEnd(string sessionStr) =>
    parts = str.split(sessionStr, "-")
    endStr = array.size(parts) >= 2 ? array.get(parts, 1) : "0000"
    endH = int(nz(str.tonumber(str.substring(endStr, 0, 2)), 0))
    endM = int(nz(str.tonumber(str.substring(endStr, 2, 4)), 0))
    secsNow = hour * 3600 + minute * 60 + second
    secsEnd = endH * 3600 + endM * 60
    secsAhead = math.max(0, secsEnd - secsNow)
    int(math.ceil(secsAhead / math.max(1, timeframe.in_seconds(timeframe.period))))

// OR box background: neutral until OR completes; then green if width ≥ `close * orSizePct%`, else red.
orSizeBackgroundColor(float rangeHigh, float rangeLow, bool isComplete) =>
    rangeWidth = na(rangeHigh) or na(rangeLow) ? na : math.abs(rangeHigh - rangeLow)
    targetSize = close * (orSizePct * 0.01)
    not isComplete or na(rangeWidth) ? sizeNeutralColor : (rangeWidth >= targetSize ? sizeGoodColor : sizeBadColor)

updateOrSizeLabel(label existingLabel, box rangeBox, float topY, float rangeWidth) =>
    left = box.get_left(rangeBox)
    right = box.get_right(rangeBox)
    midX = int(math.round((left + right) / 2.0))
    calculatedSize = close * (orSizePct * 0.01)
    rangeRatio = calculatedSize > 0 ? rangeWidth / calculatedSize : 0
    textColor = rangeRatio >= 1 ? color.new(#00ff00, 0) : color.red
    yPos = topY + orSizeLabelPaddingBottom
    labelText = "Δ " + str.tostring(rangeWidth, format.mintick) + "\n" + "◇ " + str.tostring(rangeRatio, "#.##") + "\n" + "= " + str.tostring(calculatedSize, format.mintick)
    if na(existingLabel)
        label.new(midX, yPos, labelText, style = label.style_label_down, textcolor = textColor, color = invisibleColor, size = targetLabelSize, textalign = text.align_left)
    else
        label.set_x(existingLabel, midX)
        label.set_y(existingLabel, yPos)
        label.set_text(existingLabel, labelText)
        label.set_textcolor(existingLabel, textColor)
        label.set_style(existingLabel, label.style_label_down)
        label.set_textalign(existingLabel, text.align_left)
        existingLabel

createExtensionTarget(bool isUp, int index, float rangeHigh, float rangeLow, float rangeWidth) =>
    step = rangeWidth * targetPercentOfRange
    price = isUp ? rangeHigh + step * index : rangeLow - step * index
    lineColor = isUp ? upSignalColor : downSignalColor
    label.new(bar_index, price, text = str.tostring(index), tooltip = str.tostring(price, format.mintick), style = label.style_label_left, color = invisibleColor, textcolor = color.new(lineColor, 0), size = targetLabelSize)

targetLevelVisible(bool plotActive, int level, int targetCount, int targetCurrent) =>
    plotActive and shouldShowTargets and targetCount >= level and (targetDisplay == "Extended" or level <= 2 or (level <= targetCurrent and level >= targetCurrent - 2))

// --- Variables ---
var upTargets = array.new<TargetDisplay>(na)
var downTargets = array.new<TargetDisplay>(na)
var signals = array.new_label()

// Opportunity Window
var bool isOwSession = false
var bool isOwComplete = false
var float owHigh = na
var float owLow = na
var box owBox = na
var bool isSecOwSession = false
var bool isSecOwComplete = false
var float secOwHigh = na
var float secOwLow = na
var box secOwBox = na
var line secOwHighExtension = na
var line secOwLowExtension = na
var int secOwExtensionStartBar = na
var label orSizeLabel = na

// Opening Range
var bool isOrSession = false
var bool isOrComplete = false
var float openingRangeHigh = na
var float openingRangeLow = na
var float upperTrackHigh = na
var float lowerTrackLow = na
var float previousOpeningRangeMid = na
var int orStartBar = na
var int upTargetCount = na
var int downTargetCount = na
var box orBox = na

// Secondary Opening Range
var bool second_or_sesh = false
var bool second_or_token = false
var bool second_or_done = false
var float second_orh = na
var float second_orl = na
var int second_or_start_bar = na
var int second_or_start_time = na
var box second_or_bx = na

// Signals and targets
var int dailyBiasDirection = 0
var bool allowDownSignal = false
var bool allowUpSignal = false
down_signal = false
up_signal = false
var label orHighLabel = na
var label orLowLabel = na
var label orMidLabel = na

// VWAP
var float vwap_cumulative_volume = na
var float vwap_cumulative_typical_price_volume = na
var float vwap_value = na
var float vwap_variance_sum = na
var float vwap_std_dev = na
var float vwap_upper_band = na
var float vwap_lower_band = na
var float vwap_upper_band_2 = na
var float vwap_lower_band_2 = na
var bool vwap_full_session = false
vwap_session_start = false
vwap_session_end = false

// Full trading session tracking
var bool full_trading_session = false
full_session_start = false
full_session_end = false
var int orTradeDayKey = na
var int orbExtensionEndBar = na
var bool orbExtensionLocked = false

// --- Calculations ---
// Core OR series: `isOrSession` true when bar time falls in `customRangeSession` (see `tz`).
// `targetCrossHigh`/`targetCrossLow` drive target extension tracking and optionally use highs/lows instead of close.
openingRangeMid = math.avg(openingRangeHigh, openingRangeLow)
openingRangeWidth = math.abs(openingRangeHigh - openingRangeLow)
targetCrossHigh = targetCrossSource == "Close" ? close : high
targetCrossLow = targetCrossSource == "Close" ? close : low
or_len_secs = timeframe.in_seconds(orTimePeriod)
or_len_ms = int(math.max(1, or_len_secs) * 1000)
isOrSession := not na(time(timeframe.period, customRangeSession, tz))
isOrStart = isOrSession and not isOrSession[1]
isOrEnd = isOrSession[1] and not isOrSession
second_or_in_session = showSecondRange and not na(time(timeframe.period, secondRangeSession, tz))
second_or_start = second_or_in_session and not second_or_in_session[1]
second_or_session_end = second_or_in_session[1] and not second_or_in_session
second_or_elapsed_ms = na(second_or_start_time) ? 0 : int(time - second_or_start_time)
second_or_duration_reached = second_or_in_session and not second_or_done and second_or_elapsed_ms >= or_len_ms
second_or_sesh := second_or_in_session and not second_or_done

if second_or_start
    if not showHistoricalData and not na(second_or_bx)
        second_or_bx.delete()
    second_orh := high
    second_orl := low
    second_or_start_bar := bar_index
    second_or_start_time := time
    second_or_done := false
    second_or_token := false
    second_or_bx := box.new(bar_index, second_orh, bar_index, second_orl, bgcolor = secondRangeColor, border_width = 0)

if second_or_sesh and not na(second_or_bx)
    if high > second_orh
        second_orh := high
    if low < second_orl
        second_orl := low
    second_or_bx.set_top(second_orh)
    second_or_bx.set_bottom(second_orl)
    second_or_bx.set_right(bar_index)
    second_or_bx.set_bgcolor(secondRangeColor)
    if second_orh != second_orl
        second_or_token := true

if (second_or_duration_reached or second_or_session_end) and not second_or_done
    second_or_done := true
    if not na(second_or_bx)
        second_or_bx.set_right(bar_index)

// On start of OR session
if isOrStart
    for targ in upTargets
        targ.displayLabel.delete()
    for targ in downTargets
        targ.displayLabel.delete()
    for lab in signals
        if not showHistoricalData
            lab.delete()

    if not showHistoricalData
        orBox.delete()

    if not na(orHighLabel)
        label.delete(orHighLabel)
    orHighLabel := na
    if not na(orLowLabel)
        label.delete(orLowLabel)
    orLowLabel := na
    if not na(orMidLabel)
        label.delete(orMidLabel)
    orMidLabel := na
    upTargets.clear()
    downTargets.clear()

    if not na(orSizeLabel) and not showHistoricalData
        label.delete(orSizeLabel)
    orSizeLabel := na

    openingRangeHigh := high
    openingRangeLow := low
    orStartBar := bar_index
    previousOpeningRangeMid := openingRangeMid[1]
    upTargetCount := 0
    downTargetCount := 0
    allowUpSignal := true
    allowDownSignal := true
    orTradeDayKey := na
    orbExtensionEndBar := na
    orbExtensionLocked := false

    if shouldShowVWAP and vwapAnchorMode == "Session Open"
        vwap_cumulative_volume := volume
        vwap_cumulative_typical_price_volume := (high + low + close) / 3 * volume
        vwap_variance_sum := 0

    orTop = high
    orBottom = low
    orBox := box.new(bar_index, orTop, bar_index, orBottom, bgcolor = orSizeBackgroundColor(openingRangeHigh, openingRangeLow, not isOrSession and isOrComplete), border_width = 0)
    isOrComplete := false

// Running while OR session is live
if isOrSession
    if high > openingRangeHigh
        openingRangeHigh := high
    if low < openingRangeLow
        openingRangeLow := low

    orTop = openingRangeHigh
    orBottom = openingRangeLow
    orBox.set_top(orTop)
    orBox.set_bottom(orBottom)
    orBox.set_bgcolor(orSizeBackgroundColor(openingRangeHigh, openingRangeLow, not isOrSession and isOrComplete))

    if openingRangeHigh != openingRangeLow
        isOrComplete := true

    if shouldShowOrbSizeLabel
        orSizeLabel := updateOrSizeLabel(orSizeLabel, orBox, orTop, openingRangeWidth)
    else if not na(orSizeLabel)
        label.delete(orSizeLabel)
        orSizeLabel := na

// VWAP anchor (runs before cumulative VWAP math)
vwap_is_recurring_anchor = vwapAnchorMode == "Recurring Time"
vwap_anchor_parts = str.split(vwapAnchorSession, "-")
vwap_anchor_start_str = array.size(vwap_anchor_parts) > 0 ? array.get(vwap_anchor_parts, 0) : "0000"
vwap_anchor_hour = int(nz(str.tonumber(str.substring(vwap_anchor_start_str, 0, 2)), 0))
vwap_anchor_minute = int(nz(str.tonumber(str.substring(vwap_anchor_start_str, 2, 4)), 0))
vwap_anchor_secs = vwap_anchor_hour * 3600 + vwap_anchor_minute * 60
vwap_now_secs = hour(time, tz) * 3600 + minute(time, tz) * 60 + second(time, tz)
vwap_prev_secs = nz(hour(time[1], tz) * 3600 + minute(time[1], tz) * 60 + second(time[1], tz), vwap_now_secs)
vwap_day_changed = year(time, tz) != year(time[1], tz) or month(time, tz) != month(time[1], tz) or dayofmonth(time, tz) != dayofmonth(time[1], tz)
vwap_session_start_recurring = shouldShowVWAP and vwap_is_recurring_anchor and ((vwap_now_secs >= vwap_anchor_secs and vwap_prev_secs < vwap_anchor_secs) or (vwap_day_changed and vwap_now_secs >= vwap_anchor_secs))
// Plot/calc window: regular market hours only (same break as plot.style_linebr on VWAP bands).
vwap_full_session := shouldShowVWAP and session.ismarket
vwap_session_start := vwap_is_recurring_anchor ? vwap_session_start_recurring : (vwap_full_session and not vwap_full_session[1])
vwap_session_end := vwap_full_session[1] and not vwap_full_session

if vwap_session_start
    vwap_cumulative_volume := volume
    vwap_cumulative_typical_price_volume := (high + low + close) / 3 * volume
    vwap_variance_sum := 0

if shouldShowVWAP and vwap_full_session
    vwap_cumulative_volume := vwap_cumulative_volume + volume
    vwap_cumulative_typical_price_volume := vwap_cumulative_typical_price_volume + ((high + low + close) / 3 * volume)

    if vwap_cumulative_volume > 0
        vwap_value := vwap_cumulative_typical_price_volume / vwap_cumulative_volume
        typical_price = (high + low + close) / 3
        vwap_variance_sum := vwap_variance_sum + (math.pow(typical_price - vwap_value, 2) * volume)

        if vwap_cumulative_volume > 0
            vwap_std_dev := math.sqrt(vwap_variance_sum / vwap_cumulative_volume)
            vwap_upper_band := vwap_value + (vwap_std_dev * vwapStdDevMultiplier)
            vwap_lower_band := vwap_value - (vwap_std_dev * vwapStdDevMultiplier)
            vwap_upper_band_2 := vwap_value + (vwap_std_dev * vwapStdDevMultiplier2)
            vwap_lower_band_2 := vwap_value - (vwap_std_dev * vwapStdDevMultiplier2)

if vwap_session_end and shouldShowVWAP
    vwap_value := na
    vwap_upper_band := na
    vwap_lower_band := na
    vwap_upper_band_2 := na
    vwap_lower_band_2 := na

if shouldShowVWAP and not vwap_full_session
    vwap_value := na
    vwap_upper_band := na
    vwap_lower_band := na
    vwap_upper_band_2 := na
    vwap_lower_band_2 := na

if isOrEnd and isOrComplete
    orBox.set_right(bar_index)

    orHighLabel := label.new(bar_index, openingRangeHigh, text = "ORH (" + str.tostring(openingRangeHigh, format.mintick) + ")", tooltip = str.tostring(openingRangeHigh, format.mintick), style = label.style_label_left, color = invisibleColor, textcolor = color.new(orLineColor, 0), size = targetLabelSize)
    orLowLabel := label.new(bar_index, openingRangeLow, text = "ORL (" + str.tostring(openingRangeLow, format.mintick) + ")", tooltip = str.tostring(openingRangeLow, format.mintick), style = label.style_label_left, color = invisibleColor, textcolor = color.new(orLineColor, 0), size = targetLabelSize)
    upperTrackHigh := openingRangeHigh + (openingRangeWidth * targetPercentOfRange)
    lowerTrackLow := openingRangeLow - (openingRangeWidth * targetPercentOfRange)
    dailyBiasDirection := openingRangeMid > previousOpeningRangeMid ? 1 : openingRangeMid < previousOpeningRangeMid ? -1 : 0
    orTradeDayKey := year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
    orBox.set_bgcolor(orSizeBackgroundColor(openingRangeHigh, openingRangeLow, true))

    if shouldShowOrbSizeLabel
        orSizeLabel := updateOrSizeLabel(orSizeLabel, orBox, box.get_top(orBox), openingRangeWidth)
    else if not na(orSizeLabel)
        label.delete(orSizeLabel)
        orSizeLabel := na

// Opportunity Window session (independent of OR)
isOwSession := shouldShowOpportunityWindow and not na(time(timeframe.period, opportunityWindowSession, tz))
isOwStart = isOwSession and not isOwSession[1]
isOwEnd = isOwSession[1] and not isOwSession
isSecOwSession := shouldShowOpportunityWindow and showSecondRange and not na(time(timeframe.period, secondaryOpportunityWindowSession, tz))
isSecOwStart = isSecOwSession and not isSecOwSession[1]
isSecOwEnd = isSecOwSession[1] and not isSecOwSession

full_trading_session := session.ismarket
full_session_start := full_trading_session and not full_trading_session[1]
full_session_end := full_trading_session[1] and not full_trading_session

// Exact same bar-by-bar visibility as VWAP upper-band and MA plots.
vwapBandPlot = shouldShowVWAP and vwap_full_session ? vwap_upper_band : na
vwapPlotting = shouldShowVWAP ? not na(vwapBandPlot) : full_trading_session
inRegularSession = not na(time(timeframe.period, session.regular))
regularSessionEnded = inRegularSession[1] and not inRegularSession
isOrTradeDay = not na(orTradeDayKey) and (year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)) == orTradeDayKey

// Freeze extension end at the regular-session close (handles session gaps with no bars).
orbExtensionBreak = regularSessionEnded or vwap_session_end or full_session_end or vwap_session_start
if isOrStart
    orbExtensionEndBar := na
    orbExtensionLocked := false
else if isOrTradeDay and not orbExtensionLocked
    extensionAdvancing = not isOrSession and isOrComplete and inRegularSession and (shouldShowVWAP ? vwapPlotting : true)
    if extensionAdvancing
        orbExtensionEndBar := bar_index
    if orbExtensionBreak or (vwapPlotting[1] and not vwapPlotting)
        orbExtensionEndBar := nz(orbExtensionEndBar[1], bar_index[1])
        orbExtensionLocked := true

orbPlotActive = not isOrSession and isOrComplete and isOrTradeDay and not na(orbExtensionEndBar) and bar_index <= orbExtensionEndBar
targetStep = openingRangeWidth * targetPercentOfRange

if orbPlotActive
    if not na(orHighLabel)
        label.set_x(orHighLabel, bar_index)
        label.set_y(orHighLabel, openingRangeHigh)
        label.set_color(orHighLabel, invisibleColor)
        label.set_textcolor(orHighLabel, color.new(orLineColor, 0))
    if not na(orLowLabel)
        label.set_x(orLowLabel, bar_index)
        label.set_y(orLowLabel, openingRangeLow)
        label.set_color(orLowLabel, invisibleColor)
        label.set_textcolor(orLowLabel, color.new(orLineColor, 0))
    if not na(orMidLabel)
        label.set_x(orMidLabel, bar_index)
        label.set_y(orMidLabel, openingRangeMid)
        label.set_color(orMidLabel, invisibleColor)
        label.set_textcolor(orMidLabel, color.new(orLineColor, 0))
    orBox.set_bgcolor(orSizeBackgroundColor(openingRangeHigh, openingRangeLow, true))
else if orbExtensionLocked and isOrTradeDay and not na(orbExtensionEndBar)
    if not na(orHighLabel)
        label.set_x(orHighLabel, orbExtensionEndBar)
        label.set_y(orHighLabel, openingRangeHigh)
        label.set_color(orHighLabel, invisibleColor)
        label.set_textcolor(orHighLabel, color.new(orLineColor, 0))
    if not na(orLowLabel)
        label.set_x(orLowLabel, orbExtensionEndBar)
        label.set_y(orLowLabel, openingRangeLow)
        label.set_color(orLowLabel, invisibleColor)
        label.set_textcolor(orLowLabel, color.new(orLineColor, 0))
    if not na(orMidLabel)
        label.set_x(orMidLabel, orbExtensionEndBar)
        label.set_y(orMidLabel, openingRangeMid)
        label.set_color(orMidLabel, invisibleColor)
        label.set_textcolor(orMidLabel, color.new(orLineColor, 0))
    if shouldShowTargets
        for targ in upTargets
            label.set_x(targ.displayLabel, orbExtensionEndBar)
            label.set_color(targ.displayLabel, invisibleColor)
            label.set_textcolor(targ.displayLabel, color.new(upSignalColor, 0))
        for targ in downTargets
            label.set_x(targ.displayLabel, orbExtensionEndBar)
            label.set_color(targ.displayLabel, invisibleColor)
            label.set_textcolor(targ.displayLabel, color.new(downSignalColor, 0))
else
    if not na(orHighLabel)
        label.set_color(orHighLabel, na)
        label.set_textcolor(orHighLabel, na)
    if not na(orLowLabel)
        label.set_color(orLowLabel, na)
        label.set_textcolor(orLowLabel, na)
    if not na(orMidLabel)
        label.set_color(orMidLabel, na)
        label.set_textcolor(orMidLabel, na)
    for targ in upTargets
        label.set_color(targ.displayLabel, na)
        label.set_textcolor(targ.displayLabel, na)
    for targ in downTargets
        label.set_color(targ.displayLabel, na)
        label.set_textcolor(targ.displayLabel, na)

// Extension targets (numbered lines above/below ORH/ORL)
if targetCrossHigh > upperTrackHigh
    upperTrackHigh := targetCrossHigh
if targetCrossLow < lowerTrackLow
    lowerTrackLow := targetCrossLow

upTargetMax = math.max(2, ceilToInt((upperTrackHigh - openingRangeHigh) / (openingRangeWidth * targetPercentOfRange)))
downTargetMax = math.max(2, ceilToInt((openingRangeLow - lowerTrackLow) / (openingRangeWidth * targetPercentOfRange)))
upTargetCurrent = math.max(0, ceilToInt((targetCrossHigh - openingRangeHigh) / (openingRangeWidth * targetPercentOfRange)))
downTargetCurrent = math.max(0, ceilToInt((openingRangeLow - targetCrossLow) / (openingRangeWidth * targetPercentOfRange)))

// Breakout signals
isInOpportunityWindow = not shouldClampSignalsToOpportunityWindow or isOwSession

if close > openingRangeMid and not allowDownSignal
    allowDownSignal := true

crossUnderOrLow = ta.crossunder(close, openingRangeLow)
crossUnderTargetOne = ta.crossunder(close, openingRangeLow - openingRangeWidth * targetPercentOfRange)
if (useDailySignalBias ? ((dailyBiasDirection != 1 and crossUnderOrLow) or (dailyBiasDirection == 1 and crossUnderTargetOne)) : ta.crossunder(close, openingRangeLow)) and allowDownSignal and isInOpportunityWindow
    down_signal := true
    allowDownSignal := false

if close < openingRangeMid and not allowUpSignal
    allowUpSignal := true

crossOverOrHigh = ta.crossover(close, openingRangeHigh)
crossOverTargetOne = ta.crossover(close, openingRangeHigh + openingRangeWidth * targetPercentOfRange)
if (useDailySignalBias ? ((dailyBiasDirection != -1 and crossOverOrHigh) or (dailyBiasDirection == -1 and crossOverTargetOne)) : ta.crossover(close, openingRangeHigh)) and allowUpSignal and isInOpportunityWindow
    up_signal := true
    allowUpSignal := false

// --- Display ---
if not isOrSession and isOrComplete and isOrTradeDay
    if upTargetCount < upTargetMax and shouldShowTargets
        for i = (upTargetCount + 1) to upTargetMax
            upTargets.push(TargetDisplay.new(createExtensionTarget(true, i, openingRangeHigh, openingRangeLow, openingRangeWidth)))
            if i == upTargetMax
                upTargetCount := upTargetMax
    if downTargetCount < downTargetMax and shouldShowTargets
        for i = (downTargetCount + 1) to downTargetMax
            downTargets.push(TargetDisplay.new(createExtensionTarget(false, i, openingRangeHigh, openingRangeLow, openingRangeWidth)))
            if i == downTargetMax
                downTargetCount := downTargetMax

// On start of Opportunity Window
if isOwStart
    if not showHistoricalData and not na(owBox)
        owBox.delete()
    if not na(orMidLabel) and not showHistoricalData
        label.delete(orMidLabel)
        orMidLabel := na

    owHigh := na(openingRangeHigh) ? high : openingRangeHigh
    owLow := na(openingRangeLow) ? low : openingRangeLow
    isOwComplete := false
    owBox := box.new(bar_index, owHigh, bar_index, owLow, bgcolor = owColor, border_width = 0)

    if shouldShowOpportunityWindowMidline and not na(orStartBar) and na(orMidLabel)
        orMidLabel := label.new(bar_index, openingRangeMid, text = "MID (" + str.tostring(openingRangeMid, format.mintick) + ")", tooltip = str.tostring(openingRangeMid, format.mintick), style = label.style_label_left, color = invisibleColor, textcolor = color.new(orLineColor, 0), size = targetLabelSize)

if isOwSession
    topNow = na(openingRangeHigh) ? owHigh : openingRangeHigh
    botNow = na(openingRangeLow) ? owLow : openingRangeLow
    owBox.set_top(topNow)
    owBox.set_bottom(botNow)
    owBox.set_right(bar_index + barsUntilSessionEnd(opportunityWindowSession))

    if topNow != botNow
        isOwComplete := true

if isSecOwStart
    if not showHistoricalData and not na(secOwBox)
        secOwBox.delete()
    if not showHistoricalData and not na(secOwHighExtension)
        secOwHighExtension.delete()
        secOwLowExtension.delete()
        secOwHighExtension := na
        secOwLowExtension := na

    secOwHigh := na(second_orh) ? high : second_orh
    secOwLow := na(second_orl) ? low : second_orl
    secOwBorderColor = color.rgb(color.r(secondRangeColor), color.g(secondRangeColor), color.b(secondRangeColor), 20)
    isSecOwComplete := false
    secOwExtensionStartBar := na
    secOwBox := box.new(bar_index, secOwHigh, bar_index, secOwLow, bgcolor = color.new(secondRangeColor, 100), border_color = secOwBorderColor, border_width = 1)

    if shouldShowOpportunityWindow and showSecondRange
        secOwHighExtension := line.new(bar_index, secOwHigh, bar_index, secOwHigh, color = secOwExtLineColor, style = line.style_dotted, width = 1)
        secOwLowExtension := line.new(bar_index, secOwLow, bar_index, secOwLow, color = secOwExtLineColor, style = line.style_dotted, width = 1)

if isSecOwEnd
    secOwExtensionStartBar := not na(secOwBox) ? box.get_right(secOwBox) : bar_index

if isSecOwSession and not na(secOwBox)
    secTopNow = na(second_orh) ? secOwHigh : second_orh
    secBotNow = na(second_orl) ? secOwLow : second_orl
    secOwBox.set_top(secTopNow)
    secOwBox.set_bottom(secBotNow)
    secOwBox.set_right(bar_index + barsUntilSessionEnd(secondaryOpportunityWindowSession))
    secOwBox.set_bgcolor(color.new(secondRangeColor, 100))
    secOwBox.set_border_color(color.rgb(color.r(secondRangeColor), color.g(secondRangeColor), color.b(secondRangeColor), 20))
    secOwBox.set_border_width(1)

    if secTopNow != secBotNow
        isSecOwComplete := true

if shouldShowOpportunityWindow and showSecondRange and not na(secOwHighExtension) and not na(secOwLowExtension)
    secExtTop = na(second_orh) ? secOwHigh : second_orh
    secExtBot = na(second_orl) ? secOwLow : second_orl
    secOwExtX1 = isSecOwSession and not na(secOwBox) ? box.get_right(secOwBox) : secOwExtensionStartBar
    if not na(secOwExtX1) and not na(orbExtensionEndBar) and orbExtensionEndBar >= secOwExtX1
        line.set_color(secOwHighExtension, secOwExtLineColor)
        line.set_color(secOwLowExtension, secOwExtLineColor)
        line.set_x1(secOwHighExtension, secOwExtX1)
        line.set_x2(secOwHighExtension, orbExtensionEndBar)
        line.set_y1(secOwHighExtension, secExtTop)
        line.set_y2(secOwHighExtension, secExtTop)
        line.set_x1(secOwLowExtension, secOwExtX1)
        line.set_x2(secOwLowExtension, orbExtensionEndBar)
        line.set_y1(secOwLowExtension, secExtBot)
        line.set_y2(secOwLowExtension, secExtBot)
    else
        line.set_color(secOwHighExtension, na)
        line.set_color(secOwLowExtension, na)

if orbPlotActive and shouldShowTargets
    for targ in upTargets
        label.set_x(targ.displayLabel, bar_index)
        label.set_color(targ.displayLabel, invisibleColor)
        label.set_textcolor(targ.displayLabel, color.new(upSignalColor, 0))
    for targ in downTargets
        label.set_x(targ.displayLabel, bar_index)
        label.set_color(targ.displayLabel, invisibleColor)
        label.set_textcolor(targ.displayLabel, color.new(downSignalColor, 0))

if up_signal and shouldShowBreakoutSignals and isInOpportunityWindow
    signals.push(label.new(bar_index, openingRangeLow, style = label.style_label_center, text = "\n▲", color = invisibleColor, textcolor = upSignalColor, size = signalSize))

if down_signal and shouldShowBreakoutSignals and isInOpportunityWindow
    signals.push(label.new(bar_index, openingRangeHigh, style = label.style_label_center, text = "▼\n", color = invisibleColor, textcolor = downSignalColor, size = signalSize))

// SMMA: seed with SMA on first bar after selection, then recursive smooth; state cleared when type ≠ SMMA.
var float ma_smma_mem = na
if shouldShowMA and maType == "SMMA"
    ma_smma_mem := na(ma_smma_mem[1]) ? ta.sma(maSource, maLength) : (ma_smma_mem[1] * (maLength - 1) + maSource) / maLength
else
    ma_smma_mem := na

ma_value = shouldShowMA ? (maType == "SMMA" ? ma_smma_mem : movingAverage(maSource, maLength, maType)) : na

// ORH / ORL / MID + targets — capped at `orbExtensionEndBar` when VWAP band plot stops.
plot(orbPlotActive ? openingRangeHigh : na, title = "ORH", color = orLineColor, linewidth = 1, style = plot.style_linebr, linestyle = plot.linestyle_dotted, trackprice = false, display = display.all)
plot(orbPlotActive ? openingRangeLow : na, title = "ORL", color = orLineColor, linewidth = 1, style = plot.style_linebr, linestyle = plot.linestyle_dotted, trackprice = false, display = display.all)
plot(orbPlotActive and shouldShowOpportunityWindowMidline ? openingRangeMid : na, title = "MID", color = orLineColor, linewidth = 1, style = plot.style_linebr, linestyle = plot.linestyle_dotted, trackprice = false, display = display.all)
plot(targetLevelVisible(orbPlotActive, 1, upTargetCount, upTargetCurrent) ? openingRangeHigh + targetStep * 1 : na, title = "Up Target 1", color = upSignalColor, linewidth = 1, style = plot.style_linebr, linestyle = targetPlotLineStyle, trackprice = false, display = shouldShowTargets ? display.all : display.none, editable = false)
plot(targetLevelVisible(orbPlotActive, 2, upTargetCount, upTargetCurrent) ? openingRangeHigh + targetStep * 2 : na, title = "Up Target 2", color = upSignalColor, linewidth = 1, style = plot.style_linebr, linestyle = targetPlotLineStyle, trackprice = false, display = shouldShowTargets ? display.all : display.none, editable = false)
plot(targetLevelVisible(orbPlotActive, 3, upTargetCount, upTargetCurrent) ? openingRangeHigh + targetStep * 3 : na, title = "Up Target 3", color = upSignalColor, linewidth = 1, style = plot.style_linebr, linestyle = targetPlotLineStyle, trackprice = false, display = shouldShowTargets ? display.all : display.none, editable = false)
plot(targetLevelVisible(orbPlotActive, 4, upTargetCount, upTargetCurrent) ? openingRangeHigh + targetStep * 4 : na, title = "Up Target 4", color = upSignalColor, linewidth = 1, style = plot.style_linebr, linestyle = targetPlotLineStyle, trackprice = false, display = shouldShowTargets ? display.all : display.none, editable = false)
plot(targetLevelVisible(orbPlotActive, 5, upTargetCount, upTargetCurrent) ? openingRangeHigh + targetStep * 5 : na, title = "Up Target 5", color = upSignalColor, linewidth = 1, style = plot.style_linebr, linestyle = targetPlotLineStyle, trackprice = false, display = shouldShowTargets ? display.all : display.none, editable = false)
plot(targetLevelVisible(orbPlotActive, 6, upTargetCount, upTargetCurrent) ? openingRangeHigh + targetStep * 6 : na, title = "Up Target 6", color = upSignalColor, linewidth = 1, style = plot.style_linebr, linestyle = targetPlotLineStyle, trackprice = false, display = shouldShowTargets ? display.all : display.none, editable = false)
plot(targetLevelVisible(orbPlotActive, 1, downTargetCount, downTargetCurrent) ? openingRangeLow - targetStep * 1 : na, title = "Down Target 1", color = downSignalColor, linewidth = 1, style = plot.style_linebr, linestyle = targetPlotLineStyle, trackprice = false, display = shouldShowTargets ? display.all : display.none, editable = false)
plot(targetLevelVisible(orbPlotActive, 2, downTargetCount, downTargetCurrent) ? openingRangeLow - targetStep * 2 : na, title = "Down Target 2", color = downSignalColor, linewidth = 1, style = plot.style_linebr, linestyle = targetPlotLineStyle, trackprice = false, display = shouldShowTargets ? display.all : display.none, editable = false)
plot(targetLevelVisible(orbPlotActive, 3, downTargetCount, downTargetCurrent) ? openingRangeLow - targetStep * 3 : na, title = "Down Target 3", color = downSignalColor, linewidth = 1, style = plot.style_linebr, linestyle = targetPlotLineStyle, trackprice = false, display = shouldShowTargets ? display.all : display.none, editable = false)
plot(targetLevelVisible(orbPlotActive, 4, downTargetCount, downTargetCurrent) ? openingRangeLow - targetStep * 4 : na, title = "Down Target 4", color = downSignalColor, linewidth = 1, style = plot.style_linebr, linestyle = targetPlotLineStyle, trackprice = false, display = shouldShowTargets ? display.all : display.none, editable = false)
plot(targetLevelVisible(orbPlotActive, 5, downTargetCount, downTargetCurrent) ? openingRangeLow - targetStep * 5 : na, title = "Down Target 5", color = downSignalColor, linewidth = 1, style = plot.style_linebr, linestyle = targetPlotLineStyle, trackprice = false, display = shouldShowTargets ? display.all : display.none, editable = false)
plot(targetLevelVisible(orbPlotActive, 6, downTargetCount, downTargetCurrent) ? openingRangeLow - targetStep * 6 : na, title = "Down Target 6", color = downSignalColor, linewidth = 1, style = plot.style_linebr, linestyle = targetPlotLineStyle, trackprice = false, display = shouldShowTargets ? display.all : display.none, editable = false)

// VWAP plots
plot(vwapBandPlot, title = "VWAP Upper", color = vwapUpperBandColor, linewidth = 1, style = plot.style_linebr, trackprice = false, display = shouldShowVWAP ? display.all : display.none)
plot(shouldShowVWAP and vwap_full_session ? vwap_value : na, title = "VWAP", color = vwapColor, linewidth = 1, style = plot.style_linebr, trackprice = false, display = shouldShowVWAP ? display.all : display.none)
plot(shouldShowVWAP and vwap_full_session ? vwap_lower_band : na, title = "VWAP Lower", color = vwapLowerBandColor, linewidth = 1, style = plot.style_linebr, trackprice = false, display = shouldShowVWAP ? display.all : display.none)
plot(shouldShowVWAP and vwap_full_session ? vwap_upper_band_2 : na, title = "VWAP Upper 2", color = vwapUpperBandColor2, linewidth = 1, style = plot.style_linebr, trackprice = false, display = shouldShowVWAP ? display.all : display.none)
plot(shouldShowVWAP and vwap_full_session ? vwap_lower_band_2 : na, title = "VWAP Lower 2", color = vwapLowerBandColor2, linewidth = 1, style = plot.style_linebr, trackprice = false, display = shouldShowVWAP ? display.all : display.none)

plot(shouldShowMA and vwapPlotting ? ma_value : na, title = "Moving Average", color = maColor, linewidth = 2, style = plot.style_linebr, trackprice = false, display = shouldShowMA ? display.all : display.none)

// --- Alerts ---
var bool alertedAbove = false
var bool alertedBelow = false

if ta.change(time("D")) != 0
    alertedAbove := false
    alertedBelow := false

crossoverAbove = ta.crossover(close, openingRangeHigh)
crossunderBelow = ta.crossunder(close, openingRangeLow)
crossAbove = (not isOrSession and isOrComplete) and not alertedAbove and crossoverAbove
crossBelow = (not isOrSession and isOrComplete) and not alertedBelow and crossunderBelow

if crossAbove and isAlertAboveEnabled
    alertedAbove := true

if crossBelow and isAlertBelowEnabled
    alertedBelow := true

alertcondition(crossAbove and isAlertAboveEnabled, title = "First Cross Above ORH", message = "Price broke above the Opening Range High")
alertcondition(crossBelow and isAlertBelowEnabled, title = "First Cross Below ORL", message = "Price broke below the Opening Range Low")
