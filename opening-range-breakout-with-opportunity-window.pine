// This is a modified version of the [LuxAlgo - ORB & Targets](https://www.tradingview.com/script/fCqLTp6r-Opening-Range-with-Breakouts-Targets-LuxAlgo/) indicator from LuxAlgo
// 
// This work is licensed under a Attribution-NonCommercial-ShareAlike 4.0 International (CC BY-NC-SA 4.0) https://creativecommons.org/licenses/by-nc-sa/4.0/
// © n8rzz - Nate Geslin

// @version=6
indicator("Opening Range with Breakouts, Targets & Opportunity Window", shorttitle = "ORB Op Win", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// ---------------------------------------------------------------------------------------------------------------------}
// inputs
// ---------------------------------------------------------------------------------------------------------------------{
// Historical Display
showHist = input.bool(false, title = "Show Historical Data", group = "Historical Display", tooltip = "Displays All Data from Previous Sessions")


// Opening Range
orSizeTargetInputGroup = "Opening Range Size Target"
orTimePeriod = input.timeframe("60", title = "Length", group = "Opening Range", tooltip = "Sets the Length of Time used for determining Opening Range") 
customRangeSession = input.session("0830-0930", title = "Opening Range Timeframe", group = orSizeTargetInputGroup)
tz = input.string("UTC-5", title = "Timezone", group = orSizeTargetInputGroup, options = ["UTC-10", "UTC-8", "UTC-7", "UTC-6", "UTC-5", "UTC-4", "UTC-3", "UTC+0", "UTC+1", "UTC+2", "UTC+3", "UTC+3:30", "UTC+4", "UTC+5", "UTC+5:30", "UTC+5:45", "UTC+6","UTC+6:30", "UTC+7", "UTC+8", "UTC+9", "UTC+9:30", "UTC+10", "UTC+11", "UTC+12", "UTC+12:45", "UTC+13"])


// Opening Range Size (% of current price)
orSizePct = input.float(0.2, minval = 0.0, step = 0.01, title = "Opening Range Size (%)", group = orSizeTargetInputGroup)
sizeGoodColor = input.color(color.new(#00ff00, 90), title = "Good Range Size", group = orSizeTargetInputGroup, tooltip = "Color when opening range size meets or exceeds target")
sizeBadColor = input.color(color.new(#ff0000, 90), title = "Poor Range Size", group = orSizeTargetInputGroup, tooltip = "Color when opening range size is below target")
sizeNeutralColor = input.color(color.new(color.yellow, 85), title = "Neutral", group = orSizeTargetInputGroup, tooltip = "OR Session has not completed yet")
shouldShowOrbSizeLabel = input.bool(true, title = "Show ORB Range Size Label", group = orSizeTargetInputGroup, tooltip = "Displays the Opening Range height (Δ value) above the OR box")


// Targets
targetPercentOfRange = input.float(50, minval = 1, title = "Target % of Range", group = "Targets", tooltip = "Uses this % of OR Width to use as the distance for targets.")*0.01
targetCrossSource = input.string("Close", title = "Target Cross Source", options = ["Close","Highs/Lows"], group = "Targets", tooltip = "Uses this Source to tell the script when a target is hit in order to draw the next target.")
targetDisplay = input.string("Adaptive", title = "Target Display", options = ["Adaptive","Extended"], group = "Targets", tooltip = "Adaptive: Displays and hides targets Adaptivly based on the current price.\nExtended: Extends all targets to the current bar and does not hide any targets after generation.")
tStyle = input.string(". . .", title = "Target Line Style", options = [". . .","- - -","___"], group = "Targets")
txtSize = str.lower(input.string("Normal", title = "Target Label Size", options = ["Tiny","Small","Normal","Large","Huge"], group = "Targets"))
shouldShowTargets = input.bool(true, title = "Show Targets", group = "Targets")


// Opportunity Window
opportunityWindowInputGroup = "Opportunity Window"
opportunityWindowSession = input.session("0930-1200", title = "Start + End", group = opportunityWindowInputGroup, inline = "OWTime")
orColor = input.color(color.new(color.white, 40), title = "Opportunity Window Line + Label Color", group = opportunityWindowInputGroup)
owColor = input.color(color.new(#7b1fa2, 80), title = "Opportunity Window Fill Color", group = opportunityWindowInputGroup)
shouldShowOpportunityWindowMidline = input.bool(true, "Show Midline", group = opportunityWindowInputGroup)
shouldShowOpportunityWindow = input.bool(true, title = "Show Opportunity Window", group = opportunityWindowInputGroup)


// Breakout Signals
shouldShowBreakoutSignals = input.bool(true, title = "Show Breakout Signals", group = "Breakout Signals")
signalBias = input.string("No Bias", title = "Signal Bias", options = ["No Bias","Daily Bias"], group = "Breakout Signals", tooltip = "OR Fill Color is directional based on if the current Day/Session ORM is Above or Below the Previous ORM.\nExamples\nNo Bias: Signals Occur Regardless of OR Color\nDaily Bias: Signals do not fire until Target 1 when Breakout is in opposite direction of OR Color.") == "No Bias" ? false : true
signalSize = str.lower(input.string("Normal", title = "Signal Size", options = ["Tiny","Small","Normal","Large","Huge"], group = "Breakout Signals"))
upSignalColor = input.color(color.new(#00ff00, 10), title = "Up Color", group = "Breakout Signals")
downSignalColor = input.color(color.new(#ff0000, 10), title = "Down Color", group = "Breakout Signals")
shouldClampSingalsToOpportunityWindow = input.bool(true, title = "Clamp signals to Opportunity Window", group = "Breakout Signals")


// VWAP
shouldShowVWAP = input.bool(true, title = "Show VWAP", group = "VWAP")
vwapStdDevMultiplier = input.float(2.0, minval = 0.1, step = 0.1, title = "Standard Deviation Multiplier", group = "VWAP", tooltip = "Multiplier for VWAP standard deviation bands")
vwapColor = input.color(color.new(color.blue, 0), title = "VWAP Color", group = "VWAP")
vwapUpperBandColor = input.color(color.new(color.white, 70), title = "Upper Band Color", group = "VWAP")
vwapLowerBandColor = input.color(color.new(color.white, 70), title = "Lower Band Color", group = "VWAP")


// Alerts
isAlertAboveEnabled = input.bool(true,  title = "Enable Alert: Cross Above ORH", group = "Alerts")
isAlertBelowEnabled = input.bool(true,  title = "Enable Alert: Cross Below ORL", group = "Alerts")

invis = color.rgb(0,0,0,100)

//---------------------------------------------------------------------------------------------------------------------}
// Error
//---------------------------------------------------------------------------------------------------------------------{
if timeframe.in_seconds(timeframe.period) >= timeframe.in_seconds("D")
    runtime.error("Timeframe is too High! Please Reduce Timeframe to be Less-Than 1 Day.")

// ---------------------------------------------------------------------------------------------------------------------}
// Functions
// ---------------------------------------------------------------------------------------------------------------------{
fz(_val) => _val == 0 ? 1 : _val


linestyle(_input) =>
    _input == "___"?line.style_solid:
     _input == "- - -"?line.style_dashed:
     _input == ". . ."?line.style_dotted:
     na

get_1up(_val) => (_val - math.floor(_val)) > 0 ? int(math.floor(_val) + 1) : int(_val)

getSizeBg(_orh, _orl, _complete) =>
    _orWidth = na(_orh) or na(_orl) ? na : math.abs(_orh - _orl)
    _orSize  = close * (orSizePct * 0.01)

    // Neutral until OR session is complete and valid
    not _complete or na(_orWidth) ? sizeNeutralColor : (_orWidth >= _orSize ? sizeGoodColor : sizeBadColor)

//---------------------------------------------------------------------------------------------------------------------}
// UDTs
//---------------------------------------------------------------------------------------------------------------------{
type target
    line ln
    label lab

//---------------------------------------------------------------------------------------------------------------------}
// Variables
//---------------------------------------------------------------------------------------------------------------------{
var up_targs   = array.new<target>(na)
var down_targs = array.new<target>(na)
var signals    = array.new_label()

// Opportunity Window vars
var bool  ow_sesh  = false
var bool  ow_token = false
var float owh      = na
var float owl      = na
var box   ow_bx    = na
var line  ow_midline = na
var label ow_midline_label = na

var bool  or_sesh  = false
var bool  or_token = false

var float orh = na 
var float orl = na
var float hst = na 
var float lst = na
var float prev_orm = na
var int   or_start_bar = na

var int up_count = na
var int down_count = na

var box or_bx = na

var int  day_dir = 0
var down_check = false
var up_check   = false
down_signal = false
up_signal   = false

var target h_ln = target.new(na,na)
var target l_ln = target.new(na,na)
var line   m_ln = na

// --- OR range label
var label or_range_lab = na

// VWAP variables
var float vwap_cumulative_volume = na
var float vwap_cumulative_typical_price_volume = na
var float vwap_value = na
var float vwap_variance_sum = na
var float vwap_std_dev = na
var float vwap_upper_band = na
var float vwap_lower_band = na

// VWAP session tracking
var bool vwap_full_session = false
vwap_session_start = false
vwap_session_end = false

// Full trading session tracking for midline
var bool full_trading_session = false
full_session_start = false
full_session_end = false

// ---------------------------------------------------------------------------------------------------------------------}
// Calculations
// ---------------------------------------------------------------------------------------------------------------------{
orm = math.avg(orh,orl)
orw = math.abs(orh-orl)    
h_src = targetCrossSource == "Close" ? close : high
l_src = targetCrossSource == "Close" ? close : low
or_sesh := not na(time(timeframe.period, customRangeSession, tz))
or_start = or_sesh and not or_sesh[1]
or_end = or_sesh[1] and not or_sesh

// On Start of OR Session
if or_start
    for targ in up_targs
        if showHist == false
            targ.ln.delete()
        targ.lab.delete()
    for targ in down_targs
        if showHist == false
            targ.ln.delete()
        targ.lab.delete()
    for lab in signals
        if showHist == false
            lab.delete()

    if showHist == false
        or_bx.delete()
        h_ln.ln.delete()
        l_ln.ln.delete()
        m_ln.delete()
        ow_midline.delete()
        ow_midline_label.delete()

    h_ln.lab.delete()
    l_ln.lab.delete()
    up_targs.clear()
    down_targs.clear()

    // remove previous OR height label if not keeping history
    if not na(or_range_lab) and showHist == false
        label.delete(or_range_lab)
    or_range_lab := na

    orh := high
    orl := low
    or_start_bar := bar_index
    prev_orm := orm[1]
    up_count := 0
    down_count := 0
    up_check := true
    down_check := true

    // Reset VWAP calculations for new session (will be overridden by full session start)
    if shouldShowVWAP
        vwap_cumulative_volume := volume
        vwap_cumulative_typical_price_volume := (high + low + close) / 3 * volume
        vwap_variance_sum := 0

    // Create opening range box using actual high/low
    _orTop = high
    _orBottom = low
    
    // Create the opening range box - right edge will be set when session ends
    or_bx := box.new(bar_index, _orTop, bar_index, _orBottom, bgcolor = getSizeBg(orh, orl, not or_sesh and or_token), border_width = 0)

    or_token := false

// Running while OR Session is Live
if or_sesh
    if high > orh
        orh := high
    if low < orl
        orl := low
    
    // Update box to show actual high/low range
    _orTop = orh
    _orBottom = orl
    
    or_bx.set_top(_orTop)
    or_bx.set_bottom(_orBottom)
    or_bx.set_bgcolor(getSizeBg(orh, orl, not or_sesh and or_token))

    if orh != orl
        or_token := true

    // --- OR Height label (live during OR session)
    if shouldShowOrbSizeLabel
        _orLeft = box.get_left(or_bx)
        _orRight = box.get_right(or_bx)
        _midX = int(math.round((_orLeft + _orRight) / 2.0))
        _calculatedSize = close * (orSizePct * 0.01)
        _rangeRatio = _calculatedSize > 0 ? orw / _calculatedSize : 0
        yPad = _calculatedSize * 0.1
        _yPos = _orTop + yPad
        _orText  = "Δ " + str.tostring(orw, format.mintick) + "\n(" + str.tostring(_rangeRatio, "#.##") + ")\n= " + str.tostring(_calculatedSize, format.mintick)
        if na(or_range_lab)
            or_range_lab := label.new(x = _midX, y = _yPos, text = _orText, style = label.style_label_center, textcolor = color.white, color = invis, size = txtSize)
        else
            label.set_x(or_range_lab, _midX)
            label.set_y(or_range_lab, _yPos)
            label.set_text(or_range_lab, _orText)
    else if not na(or_range_lab)
        label.delete(or_range_lab)
        or_range_lab := na

// VWAP Calculations (during full trading session)
if shouldShowVWAP and vwap_full_session
    // Update cumulative volume and typical price * volume
    vwap_cumulative_volume := vwap_cumulative_volume + volume
    vwap_cumulative_typical_price_volume := vwap_cumulative_typical_price_volume + ((high + low + close) / 3 * volume)
    
    // Calculate VWAP
    if vwap_cumulative_volume > 0
        vwap_value := vwap_cumulative_typical_price_volume / vwap_cumulative_volume
        
        // Calculate variance for standard deviation
        typical_price = (high + low + close) / 3
        vwap_variance_sum := vwap_variance_sum + (math.pow(typical_price - vwap_value, 2) * volume)
        
        // Calculate standard deviation
        if vwap_cumulative_volume > 0
            vwap_std_dev := math.sqrt(vwap_variance_sum / vwap_cumulative_volume)
            
            // Calculate bands
            vwap_upper_band := vwap_value + (vwap_std_dev * vwapStdDevMultiplier)
            vwap_lower_band := vwap_value - (vwap_std_dev * vwapStdDevMultiplier)

// Reset VWAP when full session ends to prevent connection to next session
if vwap_session_end and shouldShowVWAP
    vwap_value := na
    vwap_upper_band := na
    vwap_lower_band := na
        
if or_end and or_token
    // Set the right edge of the box to the current bar when session ends
    or_bx.set_right(bar_index)
    
    h_ln := target.new(line.new(bar_index,orh,bar_index,orh, color = orColor),label.new(bar_index,orh,text = "ORH (" + str.tostring(orh,format.mintick) + ")",tooltip = str.tostring(orh,format.mintick), style = label.style_label_left, color = invis, textcolor = color.new(orColor,0), size = txtSize))
    l_ln := target.new(line.new(bar_index,orl,bar_index,orl, color = orColor),label.new(bar_index,orl,text = "ORL (" + str.tostring(orl,format.mintick) + ")",tooltip = str.tostring(orl,format.mintick), style = label.style_label_left, color = invis, textcolor = color.new(orColor,0), size = txtSize))
    hst := orh + (orw*targetPercentOfRange)
    lst := orl - (orw*targetPercentOfRange)
    day_dir := orm > prev_orm ? 1 : orm < prev_orm ? -1 : 0
    
    or_bx.set_bgcolor(getSizeBg(orh, orl, true))

    // --- Freeze the height label at final midpoint above OR box
    if shouldShowOrbSizeLabel
        _orLeftF = box.get_left(or_bx)
        _orRightF = box.get_right(or_bx)
        _midXF = int(math.round((_orLeftF + _orRightF) / 2.0))
        _calculatedSize = close * (orSizePct * 0.01)
        _rangeRatio = _calculatedSize > 0 ? orw / _calculatedSize : 0
        _yPosF = box.get_top(or_bx) + (_calculatedSize * 0.1)
        _finalTxt = "Δ " + str.tostring(orw, format.mintick) + "\n(" + str.tostring(_rangeRatio, "#.##") + ")\n= " + str.tostring(_calculatedSize, format.mintick)
        if na(or_range_lab)
            or_range_lab := label.new(_midXF, _yPosF, _finalTxt, style = label.style_label_center, textcolor = color.white, color = invis, size = txtSize)
        else
            label.set_x(or_range_lab, _midXF)
            label.set_y(or_range_lab, _yPosF)
            label.set_text(or_range_lab, _finalTxt)
    else if not na(or_range_lab)
        label.delete(or_range_lab)
        or_range_lab := na


// Establishing the Opportunity Window session (independent of OR)
ow_sesh := shouldShowOpportunityWindow and not na(time(timeframe.period, opportunityWindowSession, tz))
ow_start = ow_sesh and not ow_sesh[1]
ow_end   = ow_sesh[1] and not ow_sesh

// VWAP Full Session Detection (from market open to close) - using built-in session detection
vwap_full_session := shouldShowVWAP and session.ismarket
vwap_session_start := vwap_full_session and not vwap_full_session[1]
vwap_session_end := vwap_full_session[1] and not vwap_full_session

// Full Trading Session Detection (from market open to close) for midline - using built-in session detection
full_trading_session := session.ismarket
full_session_start := full_trading_session and not full_trading_session[1]
full_session_end := full_trading_session[1] and not full_trading_session

// VWAP Session Start (reset for full trading day)
if vwap_session_start
    vwap_cumulative_volume := volume
    vwap_cumulative_typical_price_volume := (high + low + close) / 3 * volume
    vwap_variance_sum := 0

// Running outside of OR Session
if not or_sesh and or_token
    h_ln.ln.set_x2(bar_index)
    l_ln.ln.set_x2(bar_index)
    h_ln.lab.set_x(bar_index)
    l_ln.lab.set_x(bar_index)
    m_ln.set_x2(bar_index)
    or_bx.set_bgcolor(getSizeBg(orh, orl, true))

// Target Calculations
if h_src > hst
    hst := h_src
if l_src < lst
    lst := l_src

up_max   = get_1up((hst - orh)/(orw*targetPercentOfRange))
down_max = get_1up((orl - lst)/(orw*targetPercentOfRange))
up_cur   = math.max(0,get_1up((h_src - orh)/(orw*targetPercentOfRange)))
down_cur = math.max(0,get_1up((orl - l_src)/(orw*targetPercentOfRange)))


// -----------------------------
// Signal Calcs (with clamp opt)
// -----------------------------
inWin = (not shouldClampSingalsToOpportunityWindow) or (shouldClampSingalsToOpportunityWindow and ow_sesh)

if  (close > orm and down_check == false)
    down_check := true

xdown  = ta.crossunder(close,orl)
xdown2 = ta.crossunder(close,orl-orw*targetPercentOfRange)
if (signalBias ? ((day_dir != 1 and xdown) or (day_dir == 1 and xdown2)) : ta.crossunder(close,orl)) and down_check and inWin
    down_signal := true
    down_check := false

if (close < orm and up_check == false)
    up_check := true

xup  = ta.crossover(close,orh)
xup2 = ta.crossover(close,orh+orw*targetPercentOfRange)
if (signalBias ? ((day_dir != -1 and xup) or (day_dir == -1 and xup2)) : ta.crossover(close,orh)) and up_check and inWin
    up_signal := true
    up_check := false

// ---------------------------------------------------------------------------------------------------------------------}
// Display
// ---------------------------------------------------------------------------------------------------------------------{

// Targets
if not or_sesh and or_token
    if up_count < up_max and shouldShowTargets
        for i = (up_count+1) to up_max 
            up_targs.push(target.new(
              line.new(bar_index-1,(orh+orw*targetPercentOfRange*i),bar_index,(orh+(orw*targetPercentOfRange*i)), color = upSignalColor, style = linestyle(tStyle)),
              label.new(bar_index,(orh+orw*targetPercentOfRange*i),text = str.tostring(i),tooltip = str.tostring(orh+orw*targetPercentOfRange*i,format.mintick), style = label.style_label_left, color = invis, textcolor = color.new(upSignalColor,0), size = txtSize)
              ))
            if i == up_max
                up_count := up_max
    if down_count < down_max and shouldShowTargets
        for i = (down_count+1) to down_max
            down_targs.push(target.new(
              line.new(bar_index-1,(orl-orw*targetPercentOfRange*i),bar_index,(orl-(orw*targetPercentOfRange*i)), color = downSignalColor, style = linestyle(tStyle)),
              label.new(bar_index,(orl-orw*targetPercentOfRange*i),text = str.tostring(i),tooltip = str.tostring(orl-orw*targetPercentOfRange*i,format.mintick), style = label.style_label_left, color = invis, textcolor = color.new(downSignalColor,0), size = txtSize)
              ))
            if i == down_max
                down_count := down_max

// On Start of Opportunity Window
if ow_start
    if showHist == false and na(ow_bx) == false
        ow_bx.delete()
    if showHist == false and na(ow_midline) == false
        ow_midline.delete()
    if showHist == false and na(ow_midline_label) == false
        ow_midline_label.delete()

    // Use ORH/ORL if available; otherwise fall back to current bar H/L
    owh := na(orh) ? high : orh
    owl := na(orl) ? low  : orl
    ow_token := false
    ow_bx := box.new(bar_index, owh, bar_index, owl, bgcolor = owColor, border_width = 0)
    
    // Create opportunity window midline starting from opening range start
    if shouldShowOpportunityWindowMidline and not na(or_start_bar)
        ow_midpoint = (orh + orl) / 2
        // Create line from opening range start to current bar
        ow_midline := line.new(or_start_bar, ow_midpoint, bar_index, ow_midpoint, color = orColor, width = 1, style = line.style_solid)
        ow_midline_label := label.new(bar_index, ow_midpoint, text = "MID (" + str.tostring(ow_midpoint, format.mintick) + ")", tooltip = str.tostring(ow_midpoint, format.mintick), style = label.style_label_left, color = invis, textcolor = color.new(orColor, 0), size = txtSize)
    
if ow_sesh
    // Glue OW height to OR height (fallback to start H/L until OR exists)
    top_now = na(orh) ? owh : orh
    bot_now = na(orl) ? owl : orl
    ow_bx.set_top(top_now)
    ow_bx.set_bottom(bot_now)

    // Extend the box's right edge to today's OW end time (in bars ahead of 'now')
    _owParts = str.split(opportunityWindowSession, "-")
    _endStr  = array.size(_owParts) >= 2 ? array.get(_owParts, 1) : "0000"
    _endH    = str.tonumber(str.substring(_endStr, 0, 2))
    _endM    = str.tonumber(str.substring(_endStr, 2, 4))

    _secsNow = hour * 3600 + minute * 60 + second
    _secsEnd = _endH * 3600 + _endM * 60
    _secsAhead = math.max(0, _secsEnd - _secsNow)

    _barsAhead = math.ceil(_secsAhead / timeframe.in_seconds(timeframe.period))
    ow_bx.set_right(bar_index + _barsAhead)

    if top_now != bot_now
        ow_token := true
    
    // Extend opportunity window midline during session
    if shouldShowOpportunityWindowMidline and not na(ow_midline) and not na(or_start_bar)
        ow_midpoint = (orh + orl) / 2
        line.set_x2(ow_midline, bar_index)
        line.set_y1(ow_midline, ow_midpoint)
        line.set_y2(ow_midline, ow_midpoint)
        // Update MID label position and text
        if not na(ow_midline_label)
            label.set_x(ow_midline_label, bar_index)
            label.set_y(ow_midline_label, ow_midpoint)
            label.set_text(ow_midline_label, "MID (" + str.tostring(ow_midpoint, format.mintick) + ")")

// Continue extending midline after opportunity window ends but before session ends
if not ow_sesh and full_trading_session and shouldShowOpportunityWindowMidline and not na(ow_midline) and not na(or_start_bar)
    ow_midpoint = (orh + orl) / 2
    line.set_x2(ow_midline, bar_index)
    line.set_y1(ow_midline, ow_midpoint)
    line.set_y2(ow_midline, ow_midpoint)
    // Update MID label position and text
    if not na(ow_midline_label)
        label.set_x(ow_midline_label, bar_index)
        label.set_y(ow_midline_label, ow_midpoint)
        label.set_text(ow_midline_label, "MID (" + str.tostring(ow_midpoint, format.mintick) + ")")

// On End of Full Trading Session - finalize the midline
if full_session_end and shouldShowOpportunityWindowMidline and not na(ow_midline)
    // Set the final end point of the midline at session close
    line.set_x2(ow_midline, bar_index)

// Extending to Current Bar   
if targetDisplay == "Extended" and shouldShowTargets
    for targ in up_targs
        targ.ln.set_x2(bar_index)
        targ.lab.set_x(bar_index)
    for targ in down_targs
        targ.ln.set_x2(bar_index)
        targ.lab.set_x(bar_index) 

if targetDisplay == "Adaptive" and shouldShowTargets
    for targ in up_targs
        if targ.ln.get_y1() <= (orh+(orw*targetPercentOfRange*(up_cur))) and targ.ln.get_y1() >= (orh+(orw*targetPercentOfRange*(up_cur-2)))
            targ.ln.set_x2(bar_index+1)
            targ.lab.set_x(bar_index+1)
    for targ in down_targs
        if targ.ln.get_y1() <= (orl-(orw*targetPercentOfRange*(down_cur-2))) and targ.ln.get_y1() >= (orl-(orw*targetPercentOfRange*(down_cur)))
            targ.ln.set_x2(bar_index+1)
            targ.lab.set_x(bar_index+1)


// Signals (draw only if allowed by clamp/window)
if up_signal and shouldShowBreakoutSignals and inWin
    signals.push(label.new(bar_index, orl,
      style = label.style_label_center, 
      text = "\n▲", 
      color = invis, 
      textcolor = upSignalColor, 
      size = signalSize))

if down_signal and shouldShowBreakoutSignals and inWin
    signals.push(label.new(bar_index, orh,
      style = label.style_label_center, 
      text = "▼\n",
      color = invis, 
      textcolor = downSignalColor, 
      size = signalSize))

// VWAP Plots
plot(shouldShowVWAP and vwap_full_session ? vwap_value : na, 
     title="VWAP", 
     color=vwapColor, 
     linewidth=2, 
     style=plot.style_linebr,
     display=shouldShowVWAP ? display.all : display.none)

plot(shouldShowVWAP and vwap_full_session ? vwap_upper_band : na, 
     title="VWAP Upper Band", 
     color=vwapUpperBandColor, 
     linewidth=1, 
     style=plot.style_linebr,
     display=shouldShowVWAP ? display.all : display.none)

plot(shouldShowVWAP and vwap_full_session ? vwap_lower_band : na, 
     title="VWAP Lower Band", 
     color=vwapLowerBandColor, 
     linewidth=1, 
     style=plot.style_linebr,
     display=shouldShowVWAP ? display.all : display.none)

// ───────────────────────────────
// User alert settings
// ───────────────────────────────

var bool alertedAbove = false
var bool alertedBelow = false

if ta.change(time("D")) != 0
    alertedAbove := false
    alertedBelow := false

// ───────────────────────────────
// Alert logic
// ───────────────────────────────
crossover_above = ta.crossover(close, orh)
crossunder_below = ta.crossunder(close, orl)
crossAbove = (not or_sesh and or_token) and not alertedAbove and crossover_above
crossBelow = (not or_sesh and or_token) and not alertedBelow and crossunder_below

if crossAbove and isAlertAboveEnabled
    alertedAbove := true

if crossBelow and isAlertBelowEnabled
    alertedBelow := true

alertcondition(crossAbove and isAlertAboveEnabled, 
     title="First Cross Above ORH", 
     message="Price broke above the Opening Range High")

alertcondition(crossBelow and isAlertBelowEnabled, 
     title="First Cross Below ORL", 
     message="Price broke below the Opening Range Low")
